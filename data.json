  "glossary": [
    {
      "term": "Sensor Fusion",
      "definition": "Combining readings from more than one sensor so the result is more reliable than any single source. Here that means thermal, IMU, and ranging data into one picture."
    },
    {
      "term": "False Positive Rate",
      "definition": "How often the detector reports a victim or hazard when none is there. We track it in validation because noisy alerts waste rescuer time."
    },
    {
      "term": "Telemetry",
      "definition": "Sending device health and sensing outputs to an operator view. Wi-Fi first, with local buffering when the link drops."
    },
    {
      "term": "BOM",
      "definition": "Bill of materials: the full parts list with quantities and costs. We freeze it before each order so spending stays clear."
    }
  ],
